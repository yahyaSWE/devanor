# ── Database: Supabase (PostgreSQL) ──────────────────────────────
# Find these in your Supabase project: Settings → Database → Connection string.
#
# DATABASE_URL  = Transaction pooler (Supavisor), host ...pooler.supabase.com:6543
#                 Used by the app at runtime. Keep the pgbouncer flag.
# DIRECT_URL    = Direct connection, host db.<ref>.supabase.co:5432
#                 Used by Prisma for migrations only.
#
# Replace [PASSWORD] and the project ref with your own values.
DATABASE_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth.js ──────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# ── Initial admin user created by `npm run db:seed` ──────────────
SEED_ADMIN_EMAIL="admin@devanor.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Devanor Admin"

# ── Supabase Storage (file uploads: logos + downloads) ───────────
# From Supabase: Settings → API. The service_role key is SECRET (server only).
# Leave empty to fall back to local-disk storage (local dev only).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Public keys — needed for browser-direct uploads (large files bypass Vercel).
# The anon key is public/safe to expose.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Email: Resend (password reset links) ────────────────────────
# From Resend: API Keys. EMAIL_FROM must be a verified sender/domain.
# Leave RESEND_API_KEY empty to disable sending (reset still "succeeds" silently).
RESEND_API_KEY=""
EMAIL_FROM="Devanor <noreply@devanor.com>"
# Public base URL used in reset links (falls back to AUTH_URL or localhost).
NEXT_PUBLIC_APP_URL="https://devanor.com"

# ── Freshdesk web chat (customer portal support chat) ────────────
# From Freshdesk: Admin → Channels → Web Chat → Widgets → your widget →
# embed code (the token/host/widgetId passed to fdWidget.init).
# Leave the token empty to show the fallback contact card instead of the widget.
NEXT_PUBLIC_FRESHDESK_TOKEN=""
NEXT_PUBLIC_FRESHDESK_HOST="https://devanor.freshdesk.com"
NEXT_PUBLIC_FRESHDESK_WIDGET_ID=""
# Signs the JWT that identifies the logged-in customer (name/email/company).
# Same widget → Configure → User authentication → secret key. SECRET.
# Leave empty to run the chat unauthenticated.
FRESHDESK_JWT_SECRET=""
# Internal name of the custom contact field holding the company (default cf_company).
FRESHDESK_COMPANY_FIELD="cf_company"
